# Version control / tooling
.git
.gitignore
.github
.direnv
.envrc

# Nix dev environment
flake.nix
flake.lock
shell.nix

# Node modules (reinstalled inside the build stage)
**/node_modules

# Icon libraries copied out of node_modules by `npm ci`'s postinstall (large, regenerated in the
# frontend stage)
frontends/*/public/icons

# Pre-built frontend output (rebuilt fresh in the frontend stage)
dist
site

# Python caches / local envs
**/__pycache__
*.pyc
.venv
.pytest_cache

# Local SQLite databases and secrets (never bake into the image)
*.db
project.db
.env

# Local data (DATA_DIR default and legacy media locations) — a developer's
# uploads must never end up in the image
data
static/media
static/media_previews
static/media_renditions

# Not needed at runtime
testing
docs
notes
_old
