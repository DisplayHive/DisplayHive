{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "Node",
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.tsbuildinfo",
    "sourceMap": true,
    "incremental": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["ts/**/*", "js/**/*"],
  "exclude": ["node_modules", "dist"]
}
